create table emp1 (
emp_id number(3),
job varchar2(20),
salary number(10),
dept_id number(10),
manager_id number(10)
);

create table dept(
dept_id number(10),
dept_name varchar2(20),
location varchar2(20)
);


create table project(
project_id number(10),
project_name varchar2(20),
dept_id number(10)
);

